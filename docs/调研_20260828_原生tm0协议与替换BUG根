## 1. `sub_8003520`（tm0 内核）完整解出

地址 `0x08003520`，逐条反汇编（`scripts/dis_axvj.py 0x08003520`）：

```asm
08003528: ldr  r3, [r5]             ; r3 = win->template
0800352A: ldrh r2, [r5, #0x16]      ; r2 = tileDataStartOffset
0800352C: ldrh r1, [r5, #0x18]      ; r1 = tileDataOffset
0800352E: adds r2, r2, r1           ; ★ tileIdx = win[0x16] + win[0x18]
08003530: lsls r2, r2, #5           ; ★ tileIdx * 32 (4bpp tile)
08003532: ldr  r1, [r3, #0xc]       ; r1 = template->tileData
08003534: adds r1, r1, r2           ; ★ dst = tileData + tileIdx*32
08003536: ldrb r2, [r5, #0xb]       ; fontNum
08003538: ldrb r3, [r5, #0xc]       ; fg
0800353A: ldrb r4, [r5, #0xd]       ; bg
0800353C: str  r4, [sp]
0800353E: ldrb r4, [r5, #0xe]       ; shadow
08003540: str  r4, [sp, #4]
08003542: bl   #0x8003630           ; ★ sub_8003630(glyph, dst, fontNum, fg, bg, shadow)
...
0800354A: adds r2, r2, r0           ; r2 = tileIdx (重算)
0800354E: lsrs r1, r2, #0x10        ; upper = tileIdx
08003550: movs r0, #0x80
08003552: lsls r0, r0, #9           ; 0x10000
08003554: adds r2, r2, r0
08003556: lsrs r2, r2, #0x10        ; lower = tileIdx + 1
0800355A: bl   #0x80036dc           ; ★ UpdateTilemap(win, tileIdx, tileIdx+1)
```

等价 C（`sub_8003520` **纯函数，零状态推进**）：

```c
void sub_8003520(TextPrinter *win, u16 glyph) {
    u16  tileIdx = win[0x16] + win[0x18];
    u8  *dst     = win->template->tileData + (tileIdx << 5);
    sub_8003630(glyph, dst, win[0xB], win[0xC], win[0xD], win[0xE]);
    UpdateTilemap(win, tileIdx, tileIdx + 1);
}
```

## 2. `FontFunc_tm0`（`0x08003569`）—— 状态推进在这里

```asm
0800356C: bl   #0x8003520           ; sub_8003520(win, glyph)
08003570: ldrh r0, [r4, #0x18]
08003572: adds r0, #2
08003574: strh r0, [r4, #0x18]      ; ★ win[0x18] += 2
08003576: ldrb r0, [r4, #0x1b]
08003578: adds r0, #1
0800357A: strb r0, [r4, #0x1b]      ; ★ win[0x1B] += 1
```

```c
void FontFunc_tm0(TextPrinter *win, u16 glyph) {
    sub_8003520(win, glyph);
    win[0x18] += 2;   /* tileDataOffset：线性追加游标 */
    win[0x1B] += 1;   /* cursorTileX */
}
```

